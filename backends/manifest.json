{
  "manifest_version": "1",
  "parser_backend_contract_version": "1",
  "backends": [
    {
      "backend_id": "gdscript-tree-sitter",
      "language": "gdscript",
      "kind": "helper",
      "contract_version": "1",
      "delivery": "pyinstaller-onedir-helper",
      "parser_engine": "tree-sitter-gdscript",
      "parser_version": "6.1.0",
      "grammar_version": "Godot GDScript 4.x grammar supported by tree-sitter-gdscript 6.1.0",
      "runtime": "bundled-cpython",
      "path": "tomiya-python-backend/tomiya-python-backend.exe",
      "packages": [
        "tree-sitter",
        "tree-sitter-gdscript"
      ],
      "licenses": [
        "tomiya-python-backend/licenses/PyInstaller-COPYING.txt",
        "tomiya-python-backend/licenses/tree-sitter-LICENSE.txt",
        "tomiya-python-backend/licenses/tree-sitter-gdscript-LICENSE.txt"
      ]
    },
    {
      "backend_id": "cpp-libclang-helper",
      "language": "cpp",
      "kind": "helper",
      "contract_version": "1",
      "delivery": "pyinstaller-onedir-helper",
      "path": "cpp/tomiya-cpp-backend/tomiya-cpp-backend.exe",
      "parser_engine": "Clang libclang C++ translation-unit parser",
      "parser_version": "22.1.4",
      "grammar_version": "Clang C++20 default; compile_commands.json flags override",
      "runtime": "bundled-cpython-and-libclang",
      "licenses": [
        "cpp/tomiya-cpp-backend/licenses/Python-LICENSE.txt",
        "cpp/tomiya-cpp-backend/licenses/PyInstaller-COPYING.txt",
        "cpp/tomiya-cpp-backend/licenses/LLVM-LICENSE.txt"
      ],
      "project_configuration": "nearest compile_commands.json when available",
      "missing_sdk_behavior": "preserve parsed source entities and add normalized compiler diagnostics"
    },
    {
      "backend_id": "go-stdlib-types-helper",
      "language": "go",
      "kind": "helper",
      "contract_version": "1",
      "delivery": "native-helper",
      "path": "go/tomiya-go-backend.exe",
      "parser_engine": "go/parser",
      "parser_version": "Go 1.27.x standard library",
      "grammar_version": "Go 1.27 language grammar implemented by go/parser",
      "licenses": [
        "go/NOTICE.txt"
      ]
    },
    {
      "backend_id": "python-stdlib-ast",
      "language": "python",
      "kind": "helper",
      "contract_version": "1",
      "delivery": "pyinstaller-onedir-helper",
      "path": "tomiya-python-backend/tomiya-python-backend.exe",
      "parser_engine": "CPython standard-library ast",
      "parser_version": "bundled CPython runtime",
      "grammar_version": "bundled CPython grammar",
      "runtime": "bundled-cpython",
      "licenses": [
        "tomiya-python-backend/licenses/Python-LICENSE.txt",
        "tomiya-python-backend/licenses/PyInstaller-COPYING.txt",
        "tomiya-python-backend/licenses/tree-sitter-LICENSE.txt",
        "tomiya-python-backend/licenses/tree-sitter-gdscript-LICENSE.txt"
      ]
    },
    {
      "backend_id": "csharp-roslyn-helper",
      "language": "csharp",
      "kind": "helper",
      "contract_version": "1",
      "delivery": "self-contained-dotnet-helper-folder",
      "path": "csharp/tomiya-csharp-backend.exe",
      "parser_engine": "Microsoft.CodeAnalysis.CSharp",
      "parser_version": "5.9.0",
      "grammar_version": "Roslyn LanguageVersion.Preview",
      "runtime": ".NET 10 self-contained win-x64",
      "publish_mode": "one-dir",
      "licenses": [
        "licenses/roslyn-LICENSE.txt",
        "licenses/dotnet-LICENSE.txt",
        "licenses/dotnet-ThirdPartyNotices.txt"
      ]
    },
    {
      "backend_id": "java-javaparser-symbol-solver-helper",
      "language": "java",
      "kind": "helper",
      "contract_version": "1",
      "delivery": "shaded-jar-plus-jlink-runtime",
      "path": "java/tomiya-java-backend.jar",
      "parser_engine": "JavaParser",
      "parser_version": "3.28.2",
      "grammar_version": "JavaParser LanguageLevel.JAVA_26",
      "runtime": "java/runtime/bin/java.exe",
      "licenses": [
        "licenses/javaparser-NOTICE.txt",
        "java/runtime/legal/"
      ]
    }
  ]
}
